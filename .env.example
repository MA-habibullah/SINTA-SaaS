# SINTA-SaaS Environment Configuration Template

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/sinta

# Database Connection (pgsql / mysql)
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sinta_saas_db
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_CHARSET=utf8mb4

# Security & Session
SESSION_LIFETIME=120
SESSION_SECURE=false
