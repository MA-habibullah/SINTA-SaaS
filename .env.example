# ==============================================================================
# SINTA Enterprise Multi-Tenant Configuration Template
# ==============================================================================

APP_NAME="SINTA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ------------------------------------------------------------------------------
# Logging & Debugging
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# PostgreSQL Database (16 Skema Multi-Schema Search Path)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sinta_db
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SEARCH_PATH="core, siswa, akademik, kesiswaan, absensi, kepegawaian, keuangan, perpustakaan, sarpras, persuratan, bk, pdss, tracer, smk, sistem, cms, public"

# ------------------------------------------------------------------------------
# Session, Cache & Queue Drivers
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=sinta_cache_

QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Redis Configuration (Optional / High-Traffic Deployment)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# WhatsApp Gateway Integration (Fonnte / WABlas / Generic API)
# ------------------------------------------------------------------------------
WA_GATEWAY_API_KEY=""
WA_GATEWAY_URL="https://api.fonnte.com/send"

# ------------------------------------------------------------------------------
# Payment Gateway Drivers (Midtrans & TriPay)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_DRIVER=midtrans

# Midtrans Snap Sandbox / Production
MIDTRANS_MERCHANT_ID=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# TriPay Integration
TRIPAY_API_KEY=""
TRIPAY_PRIVATE_KEY=""
TRIPAY_MERCHANT_CODE=""
TRIPAY_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# Filesystem Storage & Limits
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
MAX_STORAGE_PER_TENANT_MB=5120
