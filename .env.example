# SINTA-SaaS Environment Configuration

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/sinta

# Database Connection (PostgreSQL HeidiSQL Laragon)
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sinta
DB_USERNAME=postgres
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Security & Session
SESSION_LIFETIME=120
SESSION_SECURE=false
