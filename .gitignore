# Mengabaikan file konfigurasi database lokal & env
.env
.env.local
.deploy_pass
laporan.html

# Mengabaikan konfigurasi database (berisi credential sensitif)
/app/Config/Database.php

# Mengabaikan log sampah internal
*.log

# =========================================================================
#  STORAGE: Abaikan seluruh isi file upload pengguna & rate limit temporer
# =========================================================================
/storage/app/public/*
/storage/app/rate_limit/*
/storage/sessions/*

# PENGECUALIAN: Tetap lacak berkas .htaccess untuk keamanan direktori web server
!/storage/app/public/.htaccess
!/storage/app/public/**/.htaccess

# PENGECUALIAN: Tetap lacak berkas .gitkeep agar struktur folder storage tetap ada di repository
!/storage/app/public/**/.gitkeep


# Mengabaikan folder scratch & file debugging lokal
/scratch/
test_*.php
rename_script.php
database_export.sql
SOP_INSTALLATION.*

# Mengabaikan file sistem operasi
.DS_Store
Thumbs.db

# Mengabaikan konfigurasi IDE editor lokal
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# Node modules / Dependencies
node_modules/